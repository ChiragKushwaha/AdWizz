<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android 17+: needed to answer other devices on the hotspot / Wi-Fi (the Devices screen's
         setup page). Without it Android silently drops the replies. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Self-updates from GitHub Releases (the app isn't distributed through Google Play). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- An ad blocker shouldn't read advertising IDs or do ad attribution: Firebase Analytics adds
         these permissions, so remove them (and the matching collection flags are off below). -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />

    <!-- Lets the "AdWizz Reels Blocker" add-on read the "Block Reels & Shorts" switch. Signature-only:
         just our own add-on, signed with the same key, can hold it. -->
    <permission
        android:name="${applicationId}.permission.FOCUS_STATE"
        android:protectionLevel="signature" />

    <!-- Lets the "Excluded apps" picker list installed apps (Android 11+ package visibility). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Whether the Reels blocker add-on is installed. -->
        <package android:name="${focusPackage}" />
    </queries>

    <application
        android:name=".AdWizzApp"
        android:localeConfig="@xml/locales_config"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AdWizz">

        <!-- Firebase Analytics: usage stats only, no advertising ID / ad personalisation. -->
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_personalization_signals" android:value="false" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".vpn.AdBlockVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <!-- Lets the system restart us when the user enables Always-on VPN. -->
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="true" />
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local DNS filtering VPN that blocks ad and tracker domains on-device" />
        </service>

        <receiver
            android:name=".vpn.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Install results for self-updates. Not exported: only our own PendingIntent reaches it. -->
        <receiver
            android:name=".data.InstallResultReceiver"
            android:exported="false" />

        <service
            android:name=".vpn.ToggleTileService"
            android:exported="true"
                        android:icon="@drawable/ic_shield"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- The "Block Reels & Shorts" switch, for the add-on (see FocusStateProvider). -->
        <provider
            android:name=".focus.FocusStateProvider"
            android:authorities="${applicationId}.focusstate"
            android:exported="true"
            android:permission="${applicationId}.permission.FOCUS_STATE" />
    </application>
</manifest>
